# --- Self-hosting with docker compose ---
# Generate with: openssl rand -hex 24   (hex keeps it safe inside the connection URL)
POSTGRES_PASSWORD=replace-with-a-long-random-hex-string

# --- Cloudflare Tunnel ---
# Address the app's port 3000 is published on. Keep 127.0.0.1 when cloudflared runs on the host;
# use the server's LAN IP when any connector runs in a container or k3s pod.
# APP_BIND=127.0.0.1

# --- Local development without Docker (compose sets DATABASE_URL itself) ---
DATABASE_URL=postgresql://laundry:password@localhost:5432/laundry

# --- Application secrets ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.edu
DEVICE_API_SECRET=replace-with-a-long-random-secret
ADMIN_PASSWORD=replace-with-a-long-random-password
